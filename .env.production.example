# DB_SSL_CA_FILE=/run/secrets/mysql-ca.pem

# Google Cloud Console debe autorizar https://tu-dominio.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=https://tu-dominio.com/api/auth/google/callback
GOOGLE_CLIENT_ID=96532736729-eafj3lgl17g04g7ubg9cdee3h6qjf15j.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REEMPLAZAR_CON_SECRETO_NUEVO
N8N_WEBHOOK_URL=https://n8n.tu-dominio.com/webhook/grano-hoja/asistente-compras
