# Copia a .env.production y reemplaza todos los ejemplos. Nunca lo subas a Git.
PUBLIC_DOMAIN=tu-dominio.com
PUBLIC_HTTPS_ORIGIN=https://tu-dominio.com
CORS_ORIGIN=https://tu-dominio.com
FRONTEND_URL=https://tu-dominio.com
MYSQL_DATABASE=grano_hoja
MYSQL_ROOT_PASSWORD=CAMBIAR_POR_SECRETO_ROOT_LARGO
APP_DB_USER=grano_app
APP_DB_PASSWORD=REEMPLAZAR_POR_SECRETO_ALEATORIO_URL_SAFE
SESSION_SECRET=REEMPLAZAR_POR_SECRETO_HEX_DE_96_CARACTERES
SESSION_COOKIE_NAME=gh.sid
SESSION_MINUTES=30
DB_POOL_MAX=12
SESSION_DB_POOL_MAX=6
DB_CONNECT_TIMEOUT_MS=5000
LOGIN_IP_LIMIT=10
TRUST_PROXY=true
TRUST_PROXY_HOPS=1
