# Copia estos nombres en Vercel > Project > Settings > Environment Variables.
# No subas secretos reales a GitHub. Configura valores distintos en Preview y Production si corresponde.
NODE_ENV=production
SESSION_SECRET=GENERAR_96_CARACTERES_HEXADECIMALES_ALEATORIOS
SESSION_COOKIE_NAME=rm.sid
SESSION_MINUTES=30
TRUST_PROXY_HOPS=1
DB_HOST=HOST_PUBLICO_DE_MYSQL
DB_PORT=3306
DB_USER=USUARIO_DE_APLICACION
DB_PASSWORD=CONTRASENA_MYSQL
DB_NAME=raiz_madera
DB_SSL=true
DB_POOL_MAX=2
SESSION_DB_POOL_MAX=2
# Usar el dominio Vercel de producción o el dominio personalizado.
PUBLIC_HTTPS_ORIGIN=https://TU_PROYECTO.vercel.app
CORS_ORIGIN=https://TU_PROYECTO.vercel.app
FRONTEND_URL=https://TU_PROYECTO.vercel.app
GOOGLE_CLIENT_ID=TU_CLIENT_ID_DE_GOOGLE
GOOGLE_CLIENT_SECRET=TU_CLIENT_SECRET_DE_GOOGLE
GOOGLE_REDIRECT_URI=https://TU_PROYECTO.vercel.app/api/auth/google/callback
N8N_WEBHOOK_URL=https://TU_N8N_DOMINIO/webhook/raiz-madera/asistente-compras
N8N_API_BASE_URL=https://TU_PROYECTO.vercel.app
N8N_WEBHOOK_AUTH_TOKEN=GENERAR_SECRETO_HEXADECIMAL_96_CARACTERES
N8N_API_SERVICE_TOKEN=GENERAR_OTRO_SECRETO_HEXADECIMAL_96_CARACTERES
LOGIN_IP_LIMIT=10
