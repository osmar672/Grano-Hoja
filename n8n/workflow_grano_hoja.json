      "position": [
        890,
        500
      ]
    },
    {
      "parameters": {
        "toolDescription": "Obtiene unidades vendidas por producto y consumo estimado de cada insumo en las ventas confirmadas de los últimos siete días.",
        "method": "GET",
        "url": "http://host.docker.internal:3001/api/reportes/ventas-semana",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": []
        }
      },
      "id": "gh-tool-sales-007",
      "name": "Reporte ventas 7 días",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.3,
      "position": [
        1100,
        500
      ]
    },
    {
      "parameters": {
        "jsCode": "let raw = $json.output ?? $json.text ?? $json.response ?? '';\nif (typeof raw !== 'string') raw = JSON.stringify(raw);\nraw = raw.trim().replace(/^```json\\s*/i, '').replace(/^```\\s*/i, '').replace(/\\s*```$/, '');\nlet data;\ntry { data = JSON.parse(raw); } catch {\n  return [{ json: { ok: false, data: null, error: 'El agente no devolvió JSON válido. Revisa la ejecución del workflow.' } }];\n}\nif (!data || typeof data !== 'object' || !Array.isArray(data.sugerencias) || typeof data.resumen !== 'string') {\n  return [{ json: { ok: false, data: null, error: 'La salida del agente no cumple el esquema resumen/sugerencias.' } }];\n}\nreturn [{ json: { ok: true, data, error: null } }];"
      },
      "id": "gh-success-008",
      "name": "Normalizar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        950,
        230
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { ok: false, data: null, error: $json.error || 'La entrada no es válida.' } }];"
      },
      "id": "gh-input-error-009",
      "name": "Respuesta de validación",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
