    {
      "parameters": {
        "toolDescription": "Consulta insumos cuyo stock actual está por debajo de stock_minimo. Usa estos datos para identificar faltantes reales.",
        "method": "GET",
        "url": "http://host.docker.internal:3001/api/insumos/bajo-minimo",
