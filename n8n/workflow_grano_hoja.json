    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst solicitud = typeof body.solicitud === 'string' ? body.solicitud.trim() : '';\nif (!solicitud || solicitud.length > 2000) {\n  const error = !solicitud ? 'El campo solicitud es obligatorio.' : 'La solicitud no puede superar los 2000 caracteres.';\n  return [{ json: { valid: false, error, ok: false, data: null } }];\n}\nreturn [{ json: { valid: true, solicitud } }];"
      },
      "id": "gh-validate-002",
      "name": "Validar entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "gh-if-condition",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "gh-if-003",
      "name": "¿Entrada válida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.solicitud }}",
        "options": {
          "systemMessage": "Eres el asistente de compras de Grano & Hoja, una cafetería en Costa Rica. Debes basarte en los datos reales de la API, nunca inventar stock, mínimos, ventas ni unidades. Usa ambas herramientas disponibles: Insumos bajo mínimo y Reporte de ventas últimos 7 días. Cruza stock actual, stock_minimo, consumo estimado semanal y unidades vendidas. Sugiere compras solo cuando estén justificadas. Cantidad sugerida debe ser numérica y en la misma unidad que la API; usa como objetivo práctico reponer al menos el faltante hasta el mínimo y considera el consumo semanal, sin sugerir cantidades negativas. Devuelve SOLO JSON válido (sin markdown, sin texto antes/después) con esta forma exacta: {\"resumen\":\"resumen breve en español\",\"sugerencias\":[{\"insumo\":\"nombre exacto\",\"cantidad_sugerida\":0,\"unidad\":\"unidad exacta\",\"justificacion\":\"explica stock actual, mínimo y consumo de los últimos 7 días\"}]} Si no hay sugerencias, usa una lista vacía. No ejecutes compras ni modifiques datos. Si una herramienta falla, dilo en el resumen y no inventes cifras."
        }
      },
      "id": "gh-agent-004",
      "name": "AI Agent - compras",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        700,
        260
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4.1-mini"
        },
        "options": {}
      },
