# Desarrollo local. MYSQL_APP_USER/PASSWORD son la cuenta limitada que usa la API.
MYSQL_DATABASE=raiz_madera
MYSQL_ROOT_PASSWORD=CAMBIA_ESTA_PASSWORD_ROOT
MYSQL_APP_USER=raiz_app
MYSQL_APP_PASSWORD=CAMBIA_ESTA_PASSWORD_APP
# En desarrollo Docker monta n8n en 127.0.0.1:5678. Genera una clave aleatoria distinta.
N8N_ENCRYPTION_KEY=CAMBIA_ESTA_CLAVE_N8N
