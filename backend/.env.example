# Copia este archivo como backend/.env. No subas backend/.env a Git.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:CAMBIA_ESTA_PASSWORD@localhost:5432/raiz_madera
CORS_ORIGIN=http://localhost:5173
TZ=America/Costa_Rica
# Genera una clave fuerte con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_COOKIE_NAME=rm.sid
SESSION_MINUTES=30
TRUST_PROXY=false
# Solo producción: origen HTTPS público de la app/API; requerido con NODE_ENV=production.
PUBLIC_HTTPS_ORIGIN=
# Token de servicio exclusivo para que n8n consulte dos endpoints de lectura. Debe tener 32+ bytes.
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
N8N_API_SERVICE_TOKEN=

# Usuarios iniciales: define claves ÚNICAS antes de ejecutar npm run users:seed.
# Política: al menos 12 caracteres, mayúscula, minúscula y número; máximo 72 bytes.
SEED_ADMIN_EMAIL=admin@raizymadera.local
SEED_ADMIN_NAME=Administración
SEED_ADMIN_PASSWORD=
SEED_MANAGER_EMAIL=encargado@raizymadera.local
SEED_MANAGER_NAME=Encargado de tienda
SEED_MANAGER_PASSWORD=
SEED_CASHIER_EMAIL=caja@raizymadera.local
SEED_CASHIER_NAME=Personal de caja
SEED_CASHIER_PASSWORD=

# El backend llama a n8n; estos valores nunca se exponen mediante VITE_.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/raiz-madera/asistente-compras
# Configura el mismo valor en una credencial Header Auth del Webhook de n8n (header x-rm-webhook-token).
N8N_WEBHOOK_AUTH_TOKEN=


# Google OAuth 2.0 (Google Cloud Console -> Credentials -> OAuth client ID -> Web application).
# Authorized redirect URI debe coincidir exactamente con GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
FRONTEND_URL=http://localhost:5173
