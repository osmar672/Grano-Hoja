# Copia a backend/.env. No guardes backend/.env en Git.
NODE_ENV=development
PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=grano_app
DB_PASSWORD=CAMBIA_ESTA_PASSWORD_APP
DB_NAME=grano_hoja
DB_SSL=false
DB_POOL_MAX=12
SESSION_DB_POOL_MAX=6
LOGIN_IP_LIMIT=10
DB_CONNECT_TIMEOUT_MS=5000
# Opcional: ruta al certificado CA cuando DB_SSL=true y el proveedor lo requiera.
# DB_SSL_CA_FILE=/ruta/al/certificado-ca.pem
TZ=America/Costa_Rica
SESSION_SECRET=GENERAR_96_CARACTERES_HEXADECIMALES_ALEATORIOS
SESSION_COOKIE_NAME=gh.sid
SESSION_MINUTES=30
TRUST_PROXY=false
PUBLIC_HTTPS_ORIGIN=
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Las claves nunca van en el frontend. Genera dos tokens diferentes de al menos 32 bytes.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/grano-hoja/asistente-compras
# Origin that n8n uses for report requests; for local Docker n8n, this reaches the host API.
N8N_API_BASE_URL=http://host.docker.internal:3001
N8N_WEBHOOK_AUTH_TOKEN=
N8N_API_SERVICE_TOKEN=

# Usuarios iniciales. Contraseñas únicas de 12-72 bytes, con minúscula, mayúscula y número.
SEED_ADMIN_EMAIL=admin@granoyhoja.local
SEED_ADMIN_NAME=Administración
SEED_ADMIN_PASSWORD=
SEED_MANAGER_EMAIL=encargado@granoyhoja.local
SEED_MANAGER_NAME=Encargado de tienda
SEED_MANAGER_PASSWORD=
SEED_CASHIER_EMAIL=caja@granoyhoja.local
SEED_CASHIER_NAME=Personal de caja
SEED_CASHIER_PASSWORD=

# Google OAuth: cliente tipo Web Application.
GOOGLE_CLIENT_ID=96532736729-eafj3lgl17g04g7ubg9cdee3h6qjf15j.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
FRONTEND_URL=http://localhost:5173
