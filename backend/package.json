{
  "name": "raiz-madera-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API REST para inventario y ventas de Raíz & Madera",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "check": "node scripts/check-syntax.js",
    "users:seed": "node scripts/seed-users.js",
    "test": "node --test",
    "audit": "npm audit --audit-level=moderate",
    "audit:high": "npm audit --audit-level=high",
    "audit:fix": "npm audit fix",
    "outdated": "npm outdated",
    "check:integration": "node ../scripts/check-integration.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "4.22.2",
    "bcrypt": "^6.0.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "zod": "^4.6.7",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.5",
    "express-mysql-session": "^3.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
