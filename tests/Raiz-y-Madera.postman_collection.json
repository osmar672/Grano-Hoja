            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/pedidos/{{noStockSaleId}}/anular",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Se limpia la venta pendiente', () => pm.response.to.have.status(200));",
              "pm.expect(pm.response.json().estado).to.eql('anulado');"
            ]
          }
        }
      ]
    },
    {
      "name": "Asistente de reposición",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/agente/sugerencia-compra",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"solicitud\": \"Analiza plantas, muebles y decoración por debajo del mínimo y las ventas de los últimos siete días; sugiere reposiciones justificadas.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Requiere workflow de n8n activo y credenciales configuradas. 502/503/504 indican que la integración no está disponible y deben revisarse en los logs del backend/n8n."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Respuesta válida o configuración pendiente controlada', () => pm.expect([200,502,503,504]).to.include(pm.response.code));",
              "if(pm.response.code===200){const d=pm.response.json();pm.expect(d).to.have.property('ok',true);pm.expect(d.data.sugerencias).to.be.an('array');}"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout",
